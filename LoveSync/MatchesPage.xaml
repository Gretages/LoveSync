<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LoveSync.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="LoveSync.MatchesPage"
             Title="Találatok"
             BackgroundColor="#1e1e1e">

    <ContentPage.BindingContext>
        <vm:MatchesViewModel />
    </ContentPage.BindingContext>


    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="10">
            <Label Text="❤️ Közös találatok"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#E91E63"
                   HorizontalOptions="Center" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

            <Button Text="Frissítés"
                    Command="{Binding LoadMatchesCommand}"
                    HeightRequest="40"
                    WidthRequest="120"
                    BackgroundColor="#2d2d2d"
                    TextColor="White"
                    CornerRadius="10" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Matches}"
                        Margin="10">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 VerticalItemSpacing="10"
                                 HorizontalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="0"
                           CornerRadius="15"
                           BackgroundColor="#2d2d2d"
                           BorderColor="Transparent"
                           HeightRequest="220">

                        <Grid RowDefinitions="3*, 1*">

                            <!-- ✅ Cache-busting + fallback, hogy ne ragadjon bent régi kép -->
                            <Image Grid.Row="0"
                                   Source="{Binding ImageUrlCacheBusted, TargetNullValue='placeholder.png'}"
                                   Aspect="AspectFill" />

                            <VerticalStackLayout Grid.Row="1"
                                                 Padding="10"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Category}"
                                       TextColor="#E91E63"
                                       FontSize="10" />
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="📭"
                           FontSize="50"
                           HorizontalOptions="Center" />
                    <Label Text="Még nincs match."
                           TextColor="Gray"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>
</ContentPage>
